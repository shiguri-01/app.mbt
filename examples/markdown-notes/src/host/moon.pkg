import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "shiguri-01/desktop/runtime" @desktop,
  "shiguri-01/desktop-markdown-notes-example/contract",
  "shiguri-01/desktop-markdown-notes-example/core",
}

supported_targets = "+native"

options(
  "is-main": true,
  link: {
    "native": {
      "cc-link-flags": "advapi32.lib ole32.lib shell32.lib shlwapi.lib user32.lib version.lib",
    },
  },
)
